{
    "title": "OS layer (Hammerspoon actions)",
    "rules": [
        {
            "description": "OS: right Cmd held is Hyper (Ctrl+Opt+Cmd+Shift)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_command",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_shift",
                            "modifiers": [
                                "left_command",
                                "left_control",
                                "left_option"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "description": "OS: Cmd+Space launcher, Hyper+v clipboard history, Hyper+r reload Hammerspoon, Hyper+i show app name",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "spacebar",
                        "modifiers": {
                            "mandatory": [
                                "command"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://launcher'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "v",
                        "modifiers": {
                            "mandatory": [
                                "command",
                                "control",
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://clipboard'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "r",
                        "modifiers": {
                            "mandatory": [
                                "command",
                                "control",
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://reload'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "i",
                        "modifiers": {
                            "mandatory": [
                                "command",
                                "control",
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://appname'"
                        }
                    ]
                }
            ]
        },
        {
            "description": "Windows: Opt+Shift+h/j/k/l halves, Opt+Shift+m cycles maximized and centered sizes",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "h",
                        "modifiers": {
                            "mandatory": [
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=left'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "l",
                        "modifiers": {
                            "mandatory": [
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=right'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "k",
                        "modifiers": {
                            "mandatory": [
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=top'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "j",
                        "modifiers": {
                            "mandatory": [
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=bottom'"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "m",
                        "modifiers": {
                            "mandatory": [
                                "option",
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=cycle'"
                        }
                    ]
                }
            ]
        },
        {
            "description": "Focus toggle: tap Opt+m (tmux pane zoom in Ghostty, window maximize/restore elsewhere), hold types µ",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "m",
                        "modifiers": {
                            "mandatory": [
                                "option"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to_if_alone": [
                        {
                            "key_code": "spacebar",
                            "modifiers": [
                                "left_control"
                            ]
                        },
                        {
                            "key_code": "m"
                        }
                    ],
                    "to_if_held_down": [
                        {
                            "key_code": "m",
                            "modifiers": [
                                "left_option"
                            ],
                            "repeat": false
                        }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 250,
                        "basic.to_if_held_down_threshold_milliseconds": 250
                    },
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.mitchellh\\.ghostty$"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "m",
                        "modifiers": {
                            "mandatory": [
                                "option"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to_if_alone": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=focus'"
                        }
                    ],
                    "to_if_held_down": [
                        {
                            "key_code": "m",
                            "modifiers": [
                                "left_option"
                            ],
                            "repeat": false
                        }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 250,
                        "basic.to_if_held_down_threshold_milliseconds": 250
                    }
                }
            ]
        },
        {
            "description": "Windows: tap Opt+h moves the window to the next screen, hold types ª",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "h",
                        "modifiers": {
                            "mandatory": [
                                "option"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to_if_alone": [
                        {
                            "shell_command": "open -g 'hammerspoon://win?pos=screen'"
                        }
                    ],
                    "to_if_held_down": [
                        {
                            "key_code": "h",
                            "modifiers": [
                                "left_option"
                            ],
                            "repeat": false
                        }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 250,
                        "basic.to_if_held_down_threshold_milliseconds": 250
                    }
                }
            ]
        },
        {
            "description": "Finder: Shift+y copies the path of the selected file (like Y in vim)",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "frontmost_application_if",
                            "bundle_identifiers": [
                                "^com\\.apple\\.finder$"
                            ]
                        }
                    ],
                    "from": {
                        "key_code": "y",
                        "modifiers": {
                            "mandatory": [
                                "shift"
                            ],
                            "optional": [
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "shell_command": "open -g 'hammerspoon://finder-yank'"
                        }
                    ]
                }
            ]
        }
    ]
}