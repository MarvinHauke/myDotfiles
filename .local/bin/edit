#!/bin/sh
# edit [-n] [-e] [-w] <file|folder>...   open in nvim inside tmux, next to the work that is already open.
# -n opens it in the background, without switching to it.
# -e starts nvim in a folder too (without it a folder gets a plain shell).
# -w always opens a new window for a folder, without asking.
# Called from the shell, from Finder (key e) and from the launcher. See ~/.config/docs/launcher.md
#
# First match wins:
#   1. an nvim running in the same project   -> the file opens there as a vertical split
#   2. otherwise                              -> new window in the tmux session on screen
#   3. tmux is not running                    -> window in the session "default" (Ghostty attaches to it)
# "Same project" = same git repository; outside a repository: a folder above the file.
# Files that are not plain text are handed to `open` and use their own app.
# A single folder that a pane already sits in: a tmux menu asks, go there or open a new window.
#
# It only ever adds: no new sessions next to an existing one, and nothing is closed or killed.

PATH="/opt/homebrew/bin:$PATH"

# text types that should still open in their default app, separated by spaces (e.g. "csv svg")
default_app=""

project_of() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$1"; }
in_repo() { git -C "$1" rev-parse --show-toplevel >/dev/null 2>&1; }
inside() { case "$1/" in "$2"/*) return 0 ;; esac; return 1; } # is $1 equal to or below $2

# does an nvim with working folder $1 belong to the project of the target? prints a rank (longer = closer)
match() {
	if [ "$target_repo" = yes ]; then
		in_repo "$1" && [ "$(project_of "$1")" = "$root" ] && echo 9999
	else
		inside "$dir" "$1" && echo "${#1}"
	fi
}

is_text() {
	[ -e "$1" ] || return 0 # new file
	[ -s "$1" ] || return 0 # empty file
	[ "$(file -b --mime-encoding "$1")" != binary ]
}

# the session on screen: the one of the most recently used client
current_session() {
	tmux list-clients -F '#{client_activity} #{client_session}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

# Ghostty to the front; prints the tmux client that is on screen once there is one
show_client() {
	open -a Ghostty
	tries=0
	while [ -z "$(tmux list-clients -F '#{client_name}' 2>/dev/null)" ] && [ "$tries" -lt 30 ]; do
		sleep 0.1
		tries=$((tries + 1))
	done
	tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

tab=$(printf '\t')
# panes whose current folder is exactly $1, one per line: pane id, tab, "session:window name  (command)".
# Not the pane edit was called from. With -e only panes that run nvim there.
panes_in() {
	tmux list-panes -a -F "#{pane_id}$tab#{pane_current_path}$tab#{pane_current_command}$tab#{session_name}:#{window_index} #{window_name}" 2>/dev/null |
		DIR=$1 SELF=$TMUX_PANE EDITOR_ONLY=$editor awk -F '\t' '
			$2 == ENVIRON["DIR"] && $1 != ENVIRON["SELF"] && (ENVIRON["EDITOR_ONLY"] != "yes" || $3 == "nvim") {
				print $1 "\t" $4 "  (" $3 ")"
			}'
}

sh_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; } # one word for the shell
# inside tmux double quotes; #### because the menu and run-shell each read ## as one plain #
tmux_quote() { printf '%s' "$1" | sed 's/[\\"$]/\\&/g; s/#/####/g'; }
self=$(command -v -- "$0" 2>/dev/null) || self=$HOME/.local/bin/edit

# menu for folder $1 with the panes $2 (lines of panes_in): a row per pane, then "New window".
# Fails when no client is there to show it.
ask() {
	ask_dir=$1 ask_panes=$2
	client=$(show_client)
	[ -n "$client" ] || return 1
	flags=-w
	[ "$editor" = yes ] && flags="-w -e"
	set --
	count=0
	while IFS=$tab read -r pane label; do
		count=$((count + 1))
		[ "$count" -le 9 ] || break
		set -- "$@" "$(printf '%s' "$label" | cut -c1-50 | sed 's/#/##/g')" "$count" "switch-client -t $pane"
	done <<EOF
$ask_panes
EOF
	set -- "$@" "" "New window" n "run-shell -b \"$(tmux_quote "$(sh_quote "$self") $flags $(sh_quote "$ask_dir")")\""
	# a menu wider than the terminal is not shown at all, so a long path keeps only its end
	title=$(printf '%s' "$ask_dir" | sed "s|^$HOME|~|" | awk '{ print (length($0) > 40 ? ".." substr($0, length($0) - 37) : $0) }' | sed 's/#/##/g')
	tmux display-menu -c "$client" -T " $title is already open " -x C -y C "$@"
}

focus=yes editor=no window=no
while [ "$1" = -n ] || [ "$1" = -e ] || [ "$1" = -w ]; do
	[ "$1" = -n ] && focus=no
	[ "$1" = -e ] && editor=yes
	[ "$1" = -w ] && window=yes
	shift
done
asks=no
[ "$focus" = yes ] && [ "$window" = no ] && [ $# -eq 1 ] && asks=yes

target=""
for arg in "$@"; do
	path=$(realpath "$arg" 2>/dev/null) || path=$arg
	if [ -d "$path" ]; then
		dir=$path file=""
		zoxide add "$dir" 2>/dev/null # folders opened here also count for `z` in the shell
	else
		ext=${path##*.}
		case " $default_app " in *" $ext "*) open "$path"; continue ;; esac
		if ! is_text "$path"; then open "$path"; continue; fi
		dir=$(dirname "$path") file=$path
	fi
	root=$(project_of "$dir")
	if in_repo "$dir"; then target_repo=yes; else target_repo=no; fi
	target=""

	# 1. a running nvim in the same project
	if [ -n "$file" ]; then
		best=0
		for sock in "${TMPDIR:-/tmp/}"nvim."$USER"/*/nvim.*.0; do
			[ -S "$sock" ] || continue
			cwd=$(nvim --server "$sock" --remote-expr 'getcwd()' 2>/dev/null) || continue
			# shellcheck disable=SC2016 # $TMUX_PANE is read by nvim, not by this shell
			pane=$(nvim --server "$sock" --remote-expr '$TMUX_PANE' 2>/dev/null)
			# only an nvim whose pane exists on this tmux server
			[ -n "$pane" ] && tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || continue
			rank=$(match "$cwd")
			if [ -n "$rank" ] && [ "$rank" -gt "$best" ]; then best=$rank found=$sock target=$pane; fi
		done
		if [ -n "$target" ]; then
			quoted=$(printf '%s' "$file" | sed "s/'/''/g")
			nvim --server "$found" --remote-send '<C-\><C-N>' >/dev/null
			# jump to the file if it is already visible, otherwise split
			nvim --server "$found" --remote-expr "bufwinid(bufadd('$quoted')) > 0 ? win_gotoid(bufwinid(bufadd('$quoted'))) : execute('vsplit ' . fnameescape('$quoted'))" >/dev/null
		fi
	fi

	# a folder that is already open somewhere: ask instead of adding a second window
	if [ -z "$file" ] && [ "$asks" = yes ]; then
		open_in=$(panes_in "$dir")
		[ -n "$open_in" ] && ask "$dir" "$open_in" && exit 0
	fi

	if [ -z "$target" ]; then
		# 2. the session on screen, 3. else "default" (created only if tmux has no such session)
		session=$(current_session)
		if [ -z "$session" ]; then
			session=default
			tmux has-session -t "=$session" 2>/dev/null || tmux new-session -d -s "$session"
		fi
		# tmux reads # in a name or folder as a format, ## is a plain #
		target=$(tmux new-window -d -P -F '#{pane_id}' -t "=$session:" -n "$(basename "$dir" | sed 's/#/##/g')" -c "$(printf '%s' "$dir" | sed 's/#/##/g')")
		# nvim is typed into the new window's shell, so the window stays a normal shell after nvim quits
		if [ -n "$file" ]; then
			tmux send-keys -t "$target" "nvim -- '$(printf '%s' "$file" | sed "s/'/'\\\\''/g")'" Enter
		elif [ "$editor" = yes ]; then
			tmux send-keys -t "$target" "nvim ." Enter
		fi
	fi
done

[ -n "$target" ] && [ "$focus" = yes ] || exit 0

# show it: Ghostty to the front, tmux to that window and pane
client=$(show_client)
[ -n "$client" ] && tmux switch-client -c "$client" -t "$target"
